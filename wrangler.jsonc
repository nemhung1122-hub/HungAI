{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hungai-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUNGAI_MEMORY",
        "class_name": "HungAIMemory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HungAIMemory"
      ]
    }
  ]
}
